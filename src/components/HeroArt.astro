---
import Icon from "./Icon.astro";
---

<div class="hero-art">
  <div class="art-caption">
    <span>SOUTH FLORIDA, HOME & FAMILY</span><span>26° N · 80° W</span>
  </div>
  <svg
    class="home-illustration"
    viewBox="0 0 560 510"
    role="img"
    aria-labelledby="home-art-title"
  >
    <title id="home-art-title">
      Illustration of a welcoming South Florida home, palms, and a warm
      afternoon sun
    </title>
    <defs>
      <linearGradient id="sky" x2="0" y2="1"
        ><stop stop-color="#d9edfc"></stop><stop offset="1" stop-color="#edf7ff"
        ></stop></linearGradient
      >
      <linearGradient id="lawn" x2="0" y2="1"
        ><stop stop-color="#96ae99"></stop><stop offset="1" stop-color="#678679"
        ></stop></linearGradient
      >
      <linearGradient id="wall" x2="0" y2="1"
        ><stop stop-color="#ffffff"></stop><stop offset="1" stop-color="#dce8f3"
        ></stop></linearGradient
      >
      <pattern
        id="roof-tiles"
        width="24"
        height="14"
        patternUnits="userSpaceOnUse"
        ><rect width="24" height="14" fill="#22577f"></rect><path
          d="M0 13h24M12 0v13"
          stroke="#164163"
          stroke-width="1.5"></path></pattern
      >
    </defs>
    <path
      d="M20 490V217C20 109 126 22 280 22s260 87 260 195v273Z"
      fill="url(#sky)"></path>
    <circle cx="398" cy="134" r="58" fill="#ffffff"></circle>
    <path d="M20 326q137-30 260 4t260-6v166H20Z" fill="url(#lawn)"></path>
    <path d="M20 405q180-25 340 2t180-8v91H20Z" fill="#7c9781"></path>
    <path d="m77 268 99-106h221l91 106Z" fill="url(#roof-tiles)"></path>
    <path d="M98 267h364v132H98Z" fill="url(#wall)"></path>
    <path d="M99 274h363v11H99Z" fill="#c5d8e8" opacity=".7"></path>
    <path d="m204 272 76-79 80 79Z" fill="#ffffff"></path>
    <path
      d="m191 274 89-91 93 91"
      fill="none"
      stroke="#0e5082"
      stroke-width="9"
      stroke-linejoin="round"></path>
    <path d="M210 276h139v123H210Z" fill="#f6faff"></path>
    <path d="M251 308h57v91h-57Z" fill="#0e5082"></path>
    <path d="M261 317h36v39h-36Z" fill="#8bb7c4"></path>
    <circle cx="297" cy="370" r="3" fill="#36e958"></circle>
    <g fill="#709ead" stroke="#ffffff" stroke-width="7"
      ><path d="M122 305h64v52h-64Z"></path><path d="M377 305h60v52h-60Z"
      ></path></g
    >
    <g stroke="#dce9f3" stroke-width="3"
      ><path d="M154 305v52M122 331h64M407 305v52M377 331h60"></path></g
    >
    <path d="M222 289v110M339 289v110" stroke="#caddea" stroke-width="8"></path>
    <path d="M236 399h85l37 91H190Z" fill="#dce7f0"></path>
    <path
      d="m236 399-11 26h108M214 453h130"
      fill="none"
      stroke="#9fb9ce"
      stroke-width="2"></path>
    <path
      d="M71 397q26-110 7-235"
      fill="none"
      stroke="#52768b"
      stroke-width="12"></path>
    <path
      d="M78 168q-31-57-63-35 32 2 63 35M78 168q-20-70 11-88 5 47-11 88M78 168q38-69 70-40-44 5-70 40M78 168q-46-12-58 41 20-26 58-41M78 168q40-24 75 22-41-11-75-22"
      fill="#4e776b"></path>
    <path
      d="M494 396q-18-82 3-159"
      fill="none"
      stroke="#52768b"
      stroke-width="9"></path>
    <path
      d="M497 246q-39-61-64-33 29 1 64 33M497 246q-5-70 32-79-7 42-32 79M497 246q39-29 61 8-39-17-61-8M497 246q-38-13-50 28 26-24 50-28"
      fill="#5e8471"></path>
    <g fill="#4d7360"
      ><ellipse cx="153" cy="394" rx="61" ry="22"></ellipse><ellipse
        cx="400"
        cy="394"
        rx="56"
        ry="22"></ellipse></g
    >
    <g fill="#5cf875"
      ><circle cx="133" cy="385" r="4"></circle><circle cx="165" cy="391" r="4"
      ></circle><circle cx="402" cy="382" r="4"></circle><circle
        cx="425"
        cy="395"
        r="4"></circle></g
    >
    <path d="M20 490h520" stroke="#648071" stroke-width="2"></path>
  </svg>
  <div class="art-note">
    <span class="icon-circle"><Icon name="home" /></span><div>
      A home. A family. A next chapter.<small
        >A little clarity can make a difference.</small
      >
    </div>
  </div>
  <span class="art-side-note" aria-hidden="true">A CLEARER PATH FORWARD</span>
</div>
