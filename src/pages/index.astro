---
import Layout from "../components/Layout.astro";
import Icon from "../components/Icon.astro";
import CallButton from "../components/CallButton.astro";
import HeroArt from "../components/HeroArt.astro";
import OwnerIntro from "../components/OwnerIntro.astro";
import VideoIntro from "../components/VideoIntro.astro";
import { faqs } from "../content/home";
import { site } from "../site";
---

<Layout
  title="Inherited a Home in South Florida? | We Pay Probate"
  description="Discuss probate-related property help and a direct, as-is sale in Miami-Dade, Broward, or Palm Beach. Free initial consultation: 954-320-6336."
>
  <main id="main">
    <section class="hero-section" aria-labelledby="hero-title">
      <div class="hero wrap">
        <div class="hero-copy">
          <p class="eyebrow">
            <span class="dot"></span> MIAMI-DADE · BROWARD · PALM BEACH
          </p>
          <h1 id="hero-title">
            Inherited a home<br />in South Florida?<br /><em>Let’s talk.</em>
          </h1>
          <p class="intro">
            Explore a direct, as-is sale and possible help with probate-related
            property costs.
          </p>
          <ul class="hero-benefits">
            <li>
              <Icon name="check" size={19} />No renovations before a proposed
              sale
            </li><li>
              <Icon name="check" size={19} />Discuss belongings and cleanout
              needs
            </li><li>
              <Icon name="check" size={19} />Start by phone, even from out of
              state
            </li>
          </ul>
          <CallButton location="hero" label="Call for a free consultation" />
          <div class="hero-reassurance">
            <a href={site.phoneHref} data-call-location="hero-number"
              >{site.phone}</a
            ><span>Free initial call. No obligation to sell.</span>
          </div>
          <p class="hero-terms">
            Fee assistance and purchase rights are subject to review and a
            written agreement. <a href="#your-options"
              >See how the arrangement works.</a>
          </p>
        </div>
        <div class="hero-media">
          {
            site.media.ownerPhoto ? (
              <figure class="hero-portrait">
                <>
                  <img
                    src={site.media.ownerPhoto}
                    alt="Leo and his wife, pictured together"
                    width="1048"
                    height="838"
                    fetchpriority="high"
                  />
                  <figcaption>
                    <>
                      <strong>A small company. A personal approach.</strong>
                      <span>Meet Leo, the person behind We Pay Probate.</span>
                      <a href="#meet-leo">
                        Get to know the business <Icon name="arrow" size={17} />
                      </a>
                    </>
                  </figcaption>
                </>
              </figure>
            ) : (
              <HeroArt />
            )
          }
        </div>
      </div>
    </section>

    <div class="service-strip">
      <div class="wrap">
        <span class="strip-label"
          ><Icon name="pin" size={17} /> PROPERTY HERE. LIVE ANYWHERE.</span
        ><span>Miami-Dade County</span><span
          class="strip-dot"
          aria-hidden="true">·</span
        ><span>Broward County</span><span class="strip-dot" aria-hidden="true"
          >·</span
        ><span>Palm Beach County</span>
      </div>
    </div>

    <section
      id="your-options"
      class="offer section"
      aria-labelledby="offer-title"
    >
      <div class="wrap offer-grid">
        <div class="offer-copy">
          <p class="eyebrow">WHAT WE CAN DISCUSS</p><h2 id="offer-title">
            The home. The costs.<br />The next step.
          </h2><p class="section-intro">
            We review your property and estate-related obstacles, discuss
            whether help with probate costs is available, and explore buying the
            home directly.
          </p>
          <div class="offer-points">
            <article>
              <Icon name="home" size={25} /><div>
                <h3>A direct, as-is purchase</h3><p>
                  Tell us about repairs, updates, and anything still in the
                  house.
                </p>
              </div>
            </article><article>
              <Icon name="document" size={25} /><div>
                <h3>Possible help with probate costs</h3><p>
                  Legal, court, or other costs may be covered under an agreed
                  arrangement.
                </p>
              </div>
            </article><article>
              <Icon name="pin" size={25} /><div>
                <h3>A first conversation from anywhere</h3><p>
                  The home is in South Florida. You don’t have to be.
                </p>
              </div>
            </article>
          </div>
          <p class="buyer-note">
            <strong>Know who you’re speaking with:</strong> We Pay Probate is a prospective
            property buyer, not a law firm or an independent adviser on every selling
            option.
          </p>
        </div>
        <aside class="terms-card" aria-labelledby="terms-title">
          <p class="eyebrow">UNDERSTAND THE OFFER BEFORE YOU DECIDE</p><h3
            id="terms-title"
          >
            Help with costs.<br />Clear terms first.
          </h3><p>
            Our approach asks for the <strong
              >first right to offer and purchase the property.</strong
            > Any fee coverage, purchase rights, and other obligations must be explained
            in writing before you decide.
          </p><div class="terms-divider"></div><h4>
            Make sure you understand:
          </h4><ul>
            <li>Which costs are covered, and any limits.</li><li>
              What purchase rights you’re agreeing to.
            </li><li>
              What happens to covered costs if the purchase doesn’t go ahead.
            </li>
          </ul><p class="terms-advice">
            Take the time you need. Have a qualified attorney review any
            agreement.
          </p><CallButton
            location="offer-terms"
            label="Ask about your situation"
          />
        </aside>
      </div>
    </section>

    <OwnerIntro />
    <VideoIntro />

    <section
      id="how-it-works"
      class="process section"
      aria-labelledby="process-title"
    >
      <div class="wrap">
        <div class="section-heading">
          <div>
            <p class="eyebrow">THREE STEPS. START WITH ONE CALL.</p><h2
              id="process-title"
            >
              Here’s how it starts.
            </h2>
          </div><p>You don’t need to know every answer before reaching out.</p>
        </div>
        <ol class="steps">
          <li>
            <span class="step-number">01</span><h3>
              Tell us about the home.
            </h3><p>
              Where is it? What’s your relationship to the estate? What would
              you like to happen?
            </p>
          </li><li>
            <span class="step-number">02</span><h3>
              Understand the arrangement.
            </h3><p>
              Discuss possible assistance, purchase terms, and any fee coverage.
              Ask about the details.
            </p>
          </li><li>
            <span class="step-number">03</span><h3>Choose your next step.</h3><p
            >
              Review written terms and seek appropriate advice. A sale proceeds
              only when legal conditions are satisfied.
            </p>
          </li>
        </ol>
        <div class="process-bottom">
          <p>
            <strong
              >A first call can happen now. Probate takes its own time.</strong
            ><br />Estate requirements, title, and approvals determine the
            timeline.
          </p><CallButton
            location="process"
            label="Call for a free consultation"
          />
        </div>
      </div>
    </section>

    <section
      id="out-of-state"
      class="section wrap remote-simple"
      aria-labelledby="remote-title"
    >
      <div>
        <p class="eyebrow">FOR OUT-OF-STATE HEIRS</p><h2 id="remote-title">
          The house is here.<br />You can start from there.
        </h2>
      </div><div>
        <p>
          If the inherited home is in Miami-Dade, Broward, or Palm Beach County,
          start by phone from wherever you live.
        </p><p>
          Discuss the property, repairs, belongings, and the steps that may be
          needed before a sale. Later steps may require signatures,
          notarization, or travel.
        </p><a
          class="text-link"
          href={site.phoneHref}
          data-call-location="out-of-state"
          >Call {site.phone}<Icon name="arrow" size={18} /></a>
      </div>
    </section>

    <section
      id="questions"
      class="section faq-section"
      aria-labelledby="faq-title"
    >
      <div class="wrap faq">
        <div class="faq-heading">
          <p class="eyebrow">YOUR QUESTIONS, ANSWERED</p><h2 id="faq-title">
            Know what<br />you’re considering.
          </h2><p>
            Ask about the costs, the home, and the proposed terms. Understanding
            comes first.
          </p><a
            class="text-link"
            href={site.phoneHref}
            data-call-location="faq"
            >Ask us your question <Icon name="arrow" size={18} /></a>
        </div><div class="faq-list">
          {
            faqs.map(([question, answer]) => (
              <details>
                <>
                  <summary>
                    {question}
                    <span class="faq-plus" aria-hidden="true">
                      +
                    </span>
                  </summary>
                  <p>{answer}</p>
                </>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="closing" aria-labelledby="closing-title">
      <div class="wrap closing-inner">
        <p class="eyebrow">START WITH A CONVERSATION</p><h2 id="closing-title">
          Tell us about the home.<br /><em>Let’s discuss your next step.</em>
        </h2><p>
          Explore whether our property assistance and direct-purchase approach
          could fit your situation.
        </p><CallButton location="closing" label={"Call " + site.phone} /><p
          class="micro"
        >
          Free initial phone consultation. No obligation to sell.
        </p>
      </div>
    </section>
  </main>
</Layout>
